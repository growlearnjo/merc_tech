{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(git diff *)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(git diff *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Edit(./package.json)",
      "Bash(npm update *)",
      "Bash(npm run db:reset)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm update *)",
      "PowerShell(npm run db:reset)"
    ],
    "deny": [
      "Edit(./docs/00-ANTES.md)",
      "Edit(./docs/MEDICIONES.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-peligroso.js\"" }
        ]
      }
    ]
  }
}
