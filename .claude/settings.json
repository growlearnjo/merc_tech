{
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(git diff *)",
      "Bash(npm test)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run build)",
      "PowerShell(git diff *)",
      "PowerShell(npm test)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Edit(./package.json)",
      "Bash(npm update *)",
      "Bash(npm run db:reset)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)",
      "PowerShell(npm update *)",
      "PowerShell(npm run db:reset)",
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Edit(./docs/00-ANTES.md)",
      "Edit(./docs/MEDICIONES.md)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-peligroso.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/exigir-pruebas.js\""
          }
        ]
      }
    ]
  }
}
